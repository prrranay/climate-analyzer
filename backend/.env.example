# Application Settings
APP_NAME="Climate Hazard Trend Analyzer"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# MongoDB Settings
MONGODB_URI="<MONGO_URI>"
MONGODB_DB_NAME="climate_hazards"

# Redis Settings
REDIS_URL="<REDIS_URL>"

# Open-Meteo API Settings
OPEN_METEO_HISTORICAL_API_URL="https://archive-api.open-meteo.com/v1/archive"
OPEN_METEO_GEOCODING_API_URL="https://geocoding-api.open-meteo.com/v1/search"

# HTTP Client Resiliency Settings
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=0.5

# Climate Analysis & Baseline Settings
BASELINE_START_YEAR=1991
BASELINE_END_YEAR=2020
MIN_ANALYSIS_YEAR=1940
MAX_ANALYSIS_RANGE_YEARS=85
DATA_LAG_BUFFER_DAYS=5

# Rate Limiting Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANALYSIS_RPM=30
RATE_LIMIT_REGIONS_RPM=60
TRUSTED_PROXIES=[]

# Cache Settings
CACHE_TTL_SECONDS=86400
ANALYSIS_ALGORITHM_VERSION="v1.0.0"

# CORS Settings (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","https://dygnify-climate-analyzer.vercel.app","http://localhost:8000"]
